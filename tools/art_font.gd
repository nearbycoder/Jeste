const CELL_W := 6
const CELL_H := 9


## Builds the font atlas (16 columns, ASCII 32..127) and a widths table.
static func build() -> Dictionary:
	var img := Image.create(16 * CELL_W, 6 * CELL_H, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	var widths := PackedInt32Array()
	widths.resize(96)
	for code in range(32, 128):
		var ch := String.chr(code)
		var g: Array = GLYPHS.get(ch, GLYPHS["?"])
		var gi := code - 32
		var ox := (gi % 16) * CELL_W
		var oy := (gi / 16) * CELL_H
		var gw := 0
		for row in g.size():
			var line: String = g[row]
			gw = maxi(gw, line.length())
			for col in line.length():
				if line[col] == "1":
					img.set_pixel(ox + col, oy + row, Color.WHITE)
		widths[gi] = gw
	return {"image": img, "widths": widths}
